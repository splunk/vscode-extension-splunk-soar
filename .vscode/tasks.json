{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "yarn: watch",
			"type": "shell",
			"command": "yarn",
			"args": ["watch"],
			"problemMatcher": [
				"$ts-webpack-watch"
			],
			"isBackground": true,
			"presentation": {
				"reveal": "never",
				"group": "watchers"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			}
		}
	]
}
